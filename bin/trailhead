#!/usr/bin/env python3
"""trailhead — render a wayfinder map as a page you can check any time.

    trailhead build            # collect + render the repo you are standing in
    trailhead build --open     # …and open it
    trailhead collect          # just refresh the collected facts
    trailhead index            # rebuild the index of every rendered page
    trailhead where            # print the output path and exit

Facts come from fixed `gh` and `git` queries. The judgment half — the four
answers, the route, the meters, the ranked actions — is authored into
<repo>/.trailhead/judgment.json by the /trailhead skill or by hand.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import collect as collect_mod  # noqa: E402
import render as render_mod  # noqa: E402


def out_dir():
    env = os.environ.get("TRAILHEAD_HOME")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_STATE_HOME", "~/.local/state")
    return Path(base).expanduser() / "trailhead"


def slug(repo):
    return repo.replace("/", "__")


def load_judgment(repo_root):
    path = Path(repo_root) / ".trailhead" / "judgment.json"
    if not path.exists():
        return {}, path
    try:
        return json.loads(path.read_text(encoding="utf-8")), path
    except json.JSONDecodeError as exc:
        raise SystemExit(f"trailhead: {path} is not valid JSON — {exc}")


def repo_root(start):
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start, capture_output=True, text=True, check=True,
        ).stdout.strip()
        return Path(out)
    except subprocess.CalledProcessError:
        raise SystemExit(f"trailhead: {start} is not inside a git repository")


def cmd_build(args):
    root = repo_root(args.repo or Path.cwd())
    dest = out_dir()
    dest.mkdir(parents=True, exist_ok=True)

    try:
        state = collect_mod.collect(str(root), map_number=args.map)
    except collect_mod.CollectError as exc:
        raise SystemExit(f"trailhead: {exc}")

    judgment, jpath = load_judgment(root)
    if not judgment:
        print(
            f"trailhead: no judgment file at {jpath} — rendering collected facts only.\n"
            f"           run /trailhead review to write the four answers.",
            file=sys.stderr,
        )

    state_path = dest / f"{slug(state['repo'])}.state.json"
    state_path.write_text(json.dumps(state, indent=2), encoding="utf-8")

    page = dest / f"{slug(state['repo'])}.html"
    page.write_text(render_mod.render(state, judgment), encoding="utf-8")

    write_index(dest)

    print(page)
    if args.open:
        subprocess.run(["open", str(page)], check=False)
    return 0


def cmd_collect(args):
    root = repo_root(args.repo or Path.cwd())
    dest = out_dir()
    dest.mkdir(parents=True, exist_ok=True)
    try:
        state = collect_mod.collect(str(root), map_number=args.map)
    except collect_mod.CollectError as exc:
        raise SystemExit(f"trailhead: {exc}")
    path = dest / f"{slug(state['repo'])}.state.json"
    path.write_text(json.dumps(state, indent=2), encoding="utf-8")
    print(path)
    return 0


def cmd_where(args):
    dest = out_dir()
    if args.repo or Path.cwd():
        try:
            root = repo_root(args.repo or Path.cwd())
            state_path = dest / f"{slug(collect_mod.repo_slug(str(root)))}.html"
            print(state_path)
            return 0
        except (SystemExit, collect_mod.CollectError):
            pass
    print(dest)
    return 0


INDEX_CSS = """
:root{--ground:#EDEFEC;--surface:#fff;--ink:#161C18;--ink-2:#4A554D;--ink-3:#79847C;
--rule:#CDD5CD;--blaze:#E0A008;color-scheme:light dark}
@media(prefers-color-scheme:dark){:root{--ground:#131714;--surface:#1B211C;--ink:#E9EEEA;
--ink-2:#A4AFA7;--ink-3:#78837B;--rule:#2E362F;--blaze:#F2BC2A}}
*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);
font-family:"Archivo",ui-sans-serif,system-ui,sans-serif;font-size:16px}
.wrap{max-width:44rem;margin:0 auto;padding:3rem 1.5rem 4rem;
display:flex;flex-direction:column;gap:1.5rem}
h1{margin:0;font-size:1rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
padding-bottom:.8rem;border-bottom:2px solid var(--ink)}
ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.5rem}
a.card{background:var(--surface);border:1px solid var(--rule);border-left:4px solid var(--blaze);
padding:.9rem 1.1rem;display:flex;justify-content:space-between;align-items:baseline;
gap:1rem;color:inherit;text-decoration:none}
a.card:hover{border-color:var(--ink)}
a.card:focus-visible{outline:3px solid var(--blaze);outline-offset:3px}
.name{font-weight:600}
.when{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.74rem;color:var(--ink-3);
white-space:nowrap}
p.empty{color:var(--ink-2);font-size:.9rem}
"""


def write_index(dest):
    pages = sorted(
        (p for p in dest.glob("*.html") if p.name != "index.html"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    items = []
    for p in pages:
        repo = p.stem.replace("__", "/")
        when = datetime.fromtimestamp(p.stat().st_mtime).strftime("%-d %b %H:%M")
        items.append(
            f'<li><a class="card" href="{html.escape(p.name)}">'
            f'<span class="name">{html.escape(repo)}</span>'
            f'<span class="when">{html.escape(when)}</span></a></li>'
        )
    body = (
        f"<ul>{''.join(items)}</ul>"
        if items
        else '<p class="empty">No trailheads rendered yet. Run <code>trailhead build</code> in a repo with a wayfinder map.</p>'
    )
    (dest / "index.html").write_text(
        "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        "<title>Trailheads</title>\n"
        '<link rel="preconnect" href="https://fonts.googleapis.com">\n'
        '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap">\n'
        f"<style>{INDEX_CSS}</style>\n</head>\n<body>\n"
        f'<main class="wrap"><h1>Trailheads</h1>{body}</main>\n</body>\n</html>\n',
        encoding="utf-8",
    )


def cmd_index(args):
    dest = out_dir()
    dest.mkdir(parents=True, exist_ok=True)
    write_index(dest)
    print(dest / "index.html")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="trailhead", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    for name, fn, extra in [
        ("build", cmd_build, True),
        ("collect", cmd_collect, True),
        ("where", cmd_where, False),
        ("index", cmd_index, False),
    ]:
        p = sub.add_parser(name)
        p.set_defaults(fn=fn)
        p.add_argument("--repo", type=Path, help="repo to read (default: cwd)")
        if extra:
            p.add_argument("--map", type=int, help="map issue number, if the repo has more than one")
        if name == "build":
            p.add_argument("--open", action="store_true", help="open the page when done")

    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help()
        return 1
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
